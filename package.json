{
  "name": "react-multi-slider-pro",
  "version": "1.1.1",
  "description": "A highly customizable, accessible multi-range slider component for React with keyboard navigation, touch support, and Tailwind CSS styling",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "style": "dist/index.css",
  "files": [
    "dist"
  ],
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/programmer4web"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && rollup -c rollup.config.js && npm run build:css && node -e \"require('fs').copyFileSync('src/index.d.ts','dist/index.d.ts')\"",
    "build:css": "postcss src/output.css -o dist/index.css",
    "dev": "rollup -c rollup.config.js -w",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "postcss-cli": "^11.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rollup": "^4.67.4",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "tailwindcss": "^3.4.19"
  },
  "resolutions": {
    "source-map-js": "^1.2.2",
    "browserslist": "^4.29.5",
    "picomatch": "^4.0.7",
    "glob": "^10.5.0",
    "minimatch": "^9.0.9",
    "brace-expansion": "^2.1.7",
    "nanoid": "^3.3.20",
    "postcss": "^8.5.32",
    "postcss-selector-parser": "^6.1.5",
    "yaml": "^2.9.1"
  },
  "keywords": [
    "react",
    "slider",
    "range-slider",
    "multi-slider",
    "multi-range",
    "input",
    "form",
    "ui",
    "component",
    "accessible",
    "keyboard-navigation",
    "touch",
    "mobile",
    "tailwind",
    "customizable",
    "responsive"
  ],
  "author": "Andrei-Constantin Alexandru",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/programmer4web/react-multi-slider-pro.git"
  },
  "bugs": {
    "url": "https://github.com/programmer4web/react-multi-slider-pro/issues"
  },
  "homepage": "https://github.com/programmer4web/react-multi-slider-pro#readme",
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": [
    "*.css"
  ]
}
